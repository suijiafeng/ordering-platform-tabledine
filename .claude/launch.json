{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "merchant-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "merchant-web",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "merchant-web-alt-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "merchant-web",
      "port": 5173,
      "autoPort": true,
      "env": {
        "API_PROXY_TARGET": "http://localhost:8081"
      }
    },
    {
      "name": "miniapp-h5",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:h5"
      ],
      "cwd": "miniapp",
      "port": 10086,
      "env": {
        "TARO_APP_API_BASE": "http://127.0.0.1:8081",
        "NODE_ENV": "development"
      }
    },
    {
      "name": "customer-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "customer-web",
      "port": 3000
    }
  ]
}
