# 复制为 .env 后填写（./deploy.sh 第一次运行会自动复制）；.env 不要提交到仓库。
# 必填只有 4 项：DOMAIN、ACME_EMAIL、BOOTSTRAP_STORE_NAME、BOOTSTRAP_OWNER_PASSWORD，其余留空会自动生成。

# 域名（已解析到本服务器并完成备案）。证书、桌码链接、nginx 配置都由它派生
DOMAIN=ordering.example.com
# 申请证书时 Let's Encrypt 用来发送到期提醒的邮箱
ACME_EMAIL=admin@example.com

# 首次部署创建的门店和店主账号（之后在后台管理，这里不再使用）
BOOTSTRAP_STORE_NAME=我的小店
BOOTSTRAP_OWNER_USERNAME=owner
# 至少 8 位，首次登录后在后台修改
BOOTSTRAP_OWNER_PASSWORD=

# 以下留空即可，deploy.sh 会自动生成并写回这里
DB_USERNAME=ordering
DB_PASSWORD=
JWT_SECRET=
BOOTSTRAP_ENABLED=true
