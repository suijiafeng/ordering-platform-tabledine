# 复制为 .env 后填写；.env 不要提交到仓库
DB_USERNAME=ordering
DB_PASSWORD=请改成强密码
# 至少 32 个字符的随机串：openssl rand -base64 48
JWT_SECRET=

# 桌码链接前缀：Nginx 把 /q/<token> 跳转到顾客 H5 点餐（/h5/?token=<token>）
QR_BASE_URL=https://ordering.example.com/q/

# 支付渠道异步通知的公网地址（不含路径；后端拼接 /api/v1/pay/notify/*），必须是 HTTPS 且已备案
PAY_NOTIFY_BASE_URL=https://ordering.example.com

# 商家端若与 API 不同域才需要填（同域 Nginx 部署留空）
CORS_ALLOWED_ORIGINS=

# 微信小程序
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信支付（APIv3，商户平台 → 账户中心 → API 安全）
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=                 # 商户 API 证书序列号
WECHAT_PAY_PRIVATE_KEY=               # apiclient_key.pem 内容，PKCS8 Base64 一行，无头尾
WECHAT_PAY_API_V3_KEY=                # 32 位 APIv3 密钥
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=    # 微信支付公钥 ID（PUB_KEY_ID_...）
WECHAT_PAY_PLATFORM_PUBLIC_KEY=       # 微信支付公钥内容，Base64 一行，无头尾

# 支付宝小程序（应用私钥 PKCS8，Base64 一行，无头尾）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 首次部署自动创建门店和店主账号，成功后改回 false
BOOTSTRAP_ENABLED=true
BOOTSTRAP_STORE_NAME=我的小店
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=请改成至少8位的密码
