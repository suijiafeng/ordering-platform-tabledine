{
  "name": "ordering-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "点餐平台顾客端（微信 / 支付宝小程序）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "None",
    "framework": "React"
  },
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:alipay": "taro build --type alipay --watch",
    "build:h5": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "build:alipay": "taro build --type alipay",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@nutui/icons-react-taro": "^3.1.0-beta.1",
    "@nutui/nutui-react-taro": "^3.0.23-cpp",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-alipay": "4.3.0",
    "@tarojs/plugin-platform-h5": "^4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "^7.25.4",
    "@babel/preset-react": "^7.24.1",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@tarojs/cli": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/react": "^18.3.11",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.38",
    "react-refresh": "^0.14.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "webpack": "5.91.0"
  }
